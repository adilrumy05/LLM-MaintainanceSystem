models/
latest_prompt.txt

# Firebase / Secrets
# Canonical location is the repo root; both uploads/ scripts read ../ from there.
# No leading slash, so this also catches stray copies in subfolders.
serviceAccountKey.json
# Firebase Console downloads the key as e.g. rbacfyp-firebase-adminsdk-ab12c-....json.
# Without this, that filename is NOT ignored and gets committed by accident.
*-firebase-adminsdk-*.json

# Chat / debug artifacts
chat_transcripts/

# Windows / PowerShell scripts (IMPORTANT FIX)
*.ps1
*.bat
*.cmd
Scripts/
Activate.ps1
activate
activate.*

# Python bytecode (stronger coverage)
**/__pycache__/
*.cpython-*.pyc

# accidental project-generated scripts
*fypScripts*

#Image Migration Scripts/Checkpoints
# copy_checkpoint.json
# migrateImages.js
