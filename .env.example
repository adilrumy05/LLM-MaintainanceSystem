# ============================================
#  Maintenance Copilot — BACKEND + RAG environment
#  Copy to .env and fill in. Never commit .env.
#
#  The mobile app does NOT read this file. Expo loads env from the Expo project
#  root, so EXPO_PUBLIC_API_URL lives in LLM-Mobile/.env.local.
#  See LLM-Mobile/.env.example.
#
#  Setup walkthrough: docs/SETUP.md
#  Verified against commit 787ab88 (BGE-M3 hybrid pipeline).
# ============================================

# ── Node backend ─────────────────────────────────────────────────

# OpenAI — https://platform.openai.com/api-keys
# Used for gpt-4o-mini (answers) AND Whisper (voice transcription,
# server/routes/transcribe.js). One key covers both.
OPENAI_API_KEY=

# Node backend port. Defaults to 8000 if unset.
PORT=8000

# Where Node reaches the Python retrieval service.
RETRIEVAL_SERVICE_URL=http://localhost:8001


# ============================================================================
#  RAG pipeline
#
#  REQUIRED — NO DEFAULT. The pipeline raises RuntimeError on startup if any of
#  these is missing (see _env / _env_int / _env_bool in chunker.py).
#  EMBED_DIM is worse: ingest_to_qdrant.py does int(os.getenv("EMBED_DIM")) with
#  no default, so a missing value is a TypeError, not a helpful message.
# ============================================================================

# Embedding model. Both names must match — chunker and embedder read separately.
EMBEDDING_MODEL=BAAI/bge-m3
DENSE_EMBED_MODEL=BAAI/bge-m3

# Dense vector width. bge-m3 = 1024. The old bge-base-en-v1.5 was 768.
# Changing this against an existing collection DELETES and recreates it.
EMBED_DIM=1024

# Where model weights are cached on disk (shared by chunker and embedder).
MODEL_LOCAL_PATH=./models/bge-m3

# cpu | dml (DirectML, any DirectX 12 GPU) | cuda
# If DirectML will not initialise, use cpu — slower but always works.
DEVICE=dml

# Half precision. Required (no default). Leave false unless measured.
USE_FP16=false

# Chunks per embedding batch. Required (no default).
# bge-m3 is ~5x the parameters of bge-base — the old value of 64 exhausts memory.
EMBED_BATCH_SIZE=4


# ── Qdrant ───────────────────────────────────────────────────────

QDRANT_URL=http://localhost:6333

# Only for Qdrant Cloud. Leave blank for local Docker.
QDRANT_API_KEY=

# Collection to read and write. Omit for the historical default
# (text_chunks_general). Set this to ingest a new model into its own collection
# so the current one keeps serving and rollback is a restart, not a re-ingest.
QDRANT_COLLECTION=text_chunks_general


# ── Ingestion ────────────────────────────────────────────────────

# Folder holding the OCR/extraction output. NOT in the repository — download it:
#   https://drive.google.com/drive/folders/1zTQbmkQfKo6K997Cd6ey0Uy5cP8fsQA2?usp=drive_link
#
# Point this at wherever you put it. Andrei runs it from his Drive mount
# (G:\My Drive\RAG_OCRv1\content_extraction); a downloaded copy is identical.
#
# USE FORWARD SLASHES. python-dotenv expands escape sequences inside double
# quotes, so "G:\My Drive\..." mangles \M. Forward slashes sidestep it and
# Python accepts them on Windows:
#   EXTRACTION_DIR=C:/Users/you/Downloads/content_extraction
#
# Verify the download before a long ingest — Drive folders arrive split,
# double-nested, or path-truncated:
#   .\.venv\Scripts\python.exe server\rag\ragPhase2\verify_extraction.py
EXTRACTION_DIR=

# Ingest checkpoint directory. MUST change whenever QDRANT_COLLECTION changes.
# The checkpoint key has no model or collection in it, so a stale checkpoint
# makes every file "SKIP" and the new collection comes out empty while the run
# still reports success.
CHECKPOINT_DIR=./checkpoint

# Optional ingest filters — leave commented to process everything.
# LIMIT=0
# DOC_GROUP_FILTER=
# CLASSIFICATION_FILTER=


# ── Chunking (optional — code default in brackets) ───────────────

PARENT_CHUNK_SIZE=1500              # [1500]
CHILD_CHUNK_SIZE=500                # [400]
CHILD_OVERLAP=100                   # [80]
MIN_CHUNK_SIZE=30                   # [50]
SEMANTIC_BOUNDARY_THRESHOLD=0.65    # [0.65] must be between 0 and 1


# ── Retrieval (optional) ─────────────────────────────────────────

RETRIEVAL_TOP_K=5                   # [5]
RETRIEVAL_SCORE_MIN=0.0             # [0.0]
RETRIEVAL_HYDRATE_PARENTS=true      # [true]


# ── Firebase ─────────────────────────────────────────────────────

FIREBASE_BUCKET=rbacfyp.firebasestorage.app

# serviceAccountKey.json is a FILE, not a variable. Gitignored.
# ONE canonical location: <repo root>/serviceAccountKey.json
# (the uploads/ scripts read ../serviceAccountKey.json — do not keep a copy there)
#
# Generate your own instead of asking someone to send a private key:
#   console.firebase.google.com -> project "rbacfyp" -> Project settings
#   -> Service accounts -> Generate new private key
# Rename the download to serviceAccountKey.json. Extra keys do not invalidate
# existing ones, so this breaks nobody else's setup.


# ── Not read by any code (verified at commit 787ab88) ────────────
# Listed so nobody re-adds them believing they do something.
#   API_BASE_URL          superseded by RETRIEVAL_SERVICE_URL
#   OPENROUTER_API_KEY    no usages
#   GEMINI_API_KEY        no usages
#   LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
#       These appear in retrieval_pipeline.py, but only inside the module
#       docstring as example code. They are not read at runtime.
