# ============================================
#  Maintenance Copilot — Environment Variables
#  Copy this file to .env and fill in your values
#  Never commit .env to GitHub
# ============================================

# ── AI / LLM API Keys ────────────────────────────────────────────

# Google Gemini API key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter API key — get from https://openrouter.ai/keys
# Used as a fallback LLM provider
OPENROUTER_API_KEY=

# OpenAI API key — get from https://platform.openai.com/api-keys
# Used for the main query pipeline via gpt-4o-mini
OPENAI_API_KEY=

# ── RAG / Document Pipeline ──────────────────────────────────────

# Absolute path to the folder where uploaded documents are extracted
# Example: D:\myproject\content_extraction
EXTRACTION_DIR=

# Relative path to the local embedding model used by the RAG pipeline
MODEL_LOCAL_PATH=./models/bge-base-en-v1.5

# URL of the Qdrant vector database (runs locally via Docker)
QDRANT_URL=http://localhost:6333

# Device to run the embedding model on — use cpu unless you have a GPU
DEVICE=cpu

# ── Chunking Configuration ───────────────────────────────────────

# Size in characters of the parent document chunks
PARENT_CHUNK_SIZE=1500

# Size in characters of the child document chunks used for retrieval
CHILD_CHUNK_SIZE=500

# Number of characters of overlap between child chunks
CHILD_OVERLAP=100

# Minimum chunk size — chunks smaller than this are discarded
MIN_CHUNK_SIZE=30

# Number of chunks processed per embedding batch
EMBED_BATCH_SIZE=64

# Path to the embedding model used during ingestion
EMBEDDING_MODEL=server/rag/ragPhase2/models/bge-base-en-v1.5

# ── API URLs ─────────────────────────────────────────────────────

# The IP address of this machine on the local network followed by the API port
# This must be updated every time you switch networks or your IP changes
# Used by the Expo mobile app to reach the Node backend
# Format: http://<YOUR_IP>:8000/api
EXPO_PUBLIC_API_URL=http://<YOUR_IP>:8000/api

# Same value as EXPO_PUBLIC_API_URL — used by the Node server internally
API_BASE_URL=http://<YOUR_IP>:8000/api

# ============================================
#  NETWORK SETUP GUIDE
# ============================================
#
#  How to find your IP address on each network type:
#
#  1. University WiFi (SUTS / eduroam)
#     Open PowerShell and run: ipconfig
#     Look for "Wireless LAN adapter Wi-Fi"
#     Use the IPv4 Address shown — example: 172.17.120.52
#     Set: EXPO_PUBLIC_API_URL=http://172.17.120.52:8000/api
#
#  2. Mobile Hotspot (your phone sharing data)
#     Open PowerShell and run: ipconfig
#     Look for "Wireless LAN adapter Wi-Fi"
#     Use the IPv4 Address shown — example: 172.20.10.2
#     Set: EXPO_PUBLIC_API_URL=http://172.20.10.2:8000/api
#
#  3. Home WiFi
#     Open PowerShell and run: ipconfig
#     Look for "Wireless LAN adapter Wi-Fi"
#     Use the IPv4 Address shown — example: 192.168.0.117
#     Set: EXPO_PUBLIC_API_URL=http://192.168.0.117:8000/api
#
#  4. Windows Hotspot (PC sharing its connection)
#     Open PowerShell and run: ipconfig
#     Look for "Ethernet adapter Local Area Connection"
#     Use the IPv4 Address shown — example: 192.168.137.1
#     Set: EXPO_PUBLIC_API_URL=http://192.168.137.1:8000/api
#
#  IMPORTANT:
#  After updating the IP, restart the Node backend and Expo.
#  Your phone must be connected to the same network as your PC.
#  On web, you can use http://localhost:8000/api instead.
# ============================================