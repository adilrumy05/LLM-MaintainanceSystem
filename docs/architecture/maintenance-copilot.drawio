        </mxCell>
        <mxCell id="d9-i1" value="Firebase token verified in Node&#10;on every request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEDE4;strokeColor=#E8621D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="275" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="d9-i2" value="Role read server-side,&#10;never from the request body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEDE4;strokeColor=#E8621D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="210" height="45" as="geometry" />
        </mxCell>

        <mxCell id="d9-g2" value="2 — Access control" style="rounded=0;html=1;fillColor=none;strokeColor=#E8621D;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontStyle=1;fontColor=#E8621D;" vertex="1" parent="1">
          <mxGeometry x="340" y="240" width="250" height="205" as="geometry" />
        </mxCell>
        <mxCell id="d9-a1" value="Firestore security rules&#10;authoritative, not client JS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEDE4;strokeColor=#E8621D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="275" width="210" height="45" as="geometry" />
