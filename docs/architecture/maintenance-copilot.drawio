          <mxGeometry x="60" y="30" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d9-sub" value="The new features introduce photographs, voice, location and asset history. This is the governance that has to exist around them. Green = already delivered in Project A." style="text;html=1;fontSize=12;fontColor=#5A6B7A;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="66" width="900" height="20" as="geometry" />
        </mxCell>

