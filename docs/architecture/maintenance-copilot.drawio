        </mxCell>

        <mxCell id="d9-g1" value="1 — Identity" style="rounded=0;html=1;fillColor=none;strokeColor=#E8621D;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontStyle=1;fontColor=#E8621D;" vertex="1" parent="1">
