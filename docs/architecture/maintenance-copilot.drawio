          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="d0a-note" value="The thick arrow is the point: the app reads and writes Firebase directly for almost everything — logging in, reading tasks, saving records, opening manual files. Our own server only ever sees the questions. Firebase is Google&#39;s cloud service, and it is already where the accounts, app data and manual files live." style="text;html=1;fontSize=12;fontColor=#5A6B7A;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="745" width="1040" height="40" as="geometry" />
