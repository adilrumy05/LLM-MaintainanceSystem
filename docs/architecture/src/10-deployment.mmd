flowchart LR

    subgraph TODAY["Today — a developer laptop"]
        L1["start.bat<br/>launches 3 processes by hand"]
        L2["Node · FastAPI · Qdrant<br/>all on one machine"]
        L3["Secrets: serviceAccountKey.json<br/>plaintext on disk, no secrets manager"]
        L4["Logs: console.log"]
        L5["CI/CD: none"]
        L6["Backups: none for Qdrant<br/>recovery = re-run 7 manual stages"]
        L7["Availability: whenever someone<br/>has their laptop open"]
    end

    subgraph TARGET["Target — one small cloud host"]
        subgraph HOST["Container host"]
            C1["node-backend<br/>public, TLS"]
            C2["fastapi-retrieval<br/>internal only"]
            C3["qdrant<br/>internal only, API key set"]
            C4["Named volume<br/>qdrant storage"]
        end
        S1["Secrets manager<br/>one source, injected at runtime"]
        S2["CI/CD<br/>build · test · deploy on merge"]
        S3["Log aggregation<br/>structured, searchable"]
        S4["Monitoring + alerting<br/>uptime, latency, error rate"]
        S5["Backups<br/>Qdrant snapshot on a schedule<br/>Firestore managed export"]
        S6["Documented recovery<br/>restore snapshot, not re-ingest"]
    end

    MANAGED["☁️ Firebase — already managed<br/>Auth · Firestore · Storage"]
    DEV["💻 docker-compose<br/>retained for local development"]

