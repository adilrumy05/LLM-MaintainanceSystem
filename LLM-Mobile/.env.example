# ============================================
#  Maintenance Copilot — MOBILE APP environment
#  Copy this file to .env.local in THIS folder (LLM-Mobile/), not the repo root.
#
#  Expo reads environment variables from the Expo project root, so a value
#  placed in the repo-root .env will not reach the app.
#  Read at LLM-Mobile/services/api.js:11.
# ============================================

# The LAN IP of the PC running the Node backend, plus the API port.
# Must be updated every time you change network or your IP changes.
#
#   PowerShell:  ipconfig
#   Take the IPv4 Address of your active adapter, e.g. 192.168.0.117
#
# Your phone and PC must be on the same network.
# On web (press W in Expo) this value is ignored — api.js falls back to
# http://localhost:8000/api because the browser cannot reach the LAN IP.
EXPO_PUBLIC_API_URL=http://<YOUR_IPv4>:8000/api

# ── Warning ──────────────────────────────────────────────────────
# Everything prefixed EXPO_PUBLIC_ is embedded in the built app and is
# readable by anyone who has it. Never put an API key or secret here.
