# Expo local state — machine-specific device history and dev server settings.
# Also covered by the repo-root .gitignore, but expo-doctor checks the Expo
# project root specifically, so it is declared here too.
.expo/

# Bundle output from `expo export` — build artifacts, never committed.
dist/
dist-*/

# Native projects are generated by `npx expo prebuild` and are per-machine.
# The app runs in Expo Go, which needs neither. local.properties in particular
# hard-codes one developer's Android SDK path and breaks everyone else's build.
/android
/ios
