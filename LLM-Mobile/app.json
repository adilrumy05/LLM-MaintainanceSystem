{
  "expo": {
    "name": "LLM-Mobile",
    "slug": "LLM-Mobile",
    "owner": "princechikukwa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "We use speech recognition to let you speak your maintenance queries.",
        "NSMicrophoneUsageDescription": "We use the microphone to record your voice queries.",
        "NSMotionUsageDescription": "Used to detect a shake gesture to start voice input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.LLMMobile",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-speech-recognition",
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df13c427-51bd-4347-add7-59cdb9a9be06"
      }
    }
  }
}
